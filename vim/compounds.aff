# i only use compound for "prefix+word" non-dash compunds:
#   extraordinaire
#   préindustriel
# but not:
#   auteurice-compositeurice

# COMPOUNDRULE 1
# COMPOUNDRULE c1c2
#
# CHECKCOMPOUNDPATTERN 1
# CHECKCOMPOUNDPATTERN [aeoiu] [aeoiu]
NOCOMPOUNDSUGS

COMPOUNDRULE 2
COMPOUNDRULE (00)*HH(00)*
COMPOUNDRULE HH(00)*
